# Local development only. Replace placeholders with your own values.
NODE_ENV=development
PORT=4000

# docker-compose.yml exposes PostgreSQL on host port 5433.
DATABASE_URL=postgresql://cms:cms@localhost:5433/cms?schema=public
DIRECT_URL=postgresql://cms:cms@localhost:5433/cms?schema=public

# Local-only signing secret; use a unique secret of at least 32 characters in production.
JWT_SECRET=local-only-replace-with-a-random-secret-at-least-32-characters

# Comma-separated frontend origins. Adjust if your local ports differ.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Required only for media upload functionality. Obtain values from your Cloudinary account.
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Optional Sentry project DSN.
SENTRY_DSN=
